rules_version = '2';

// A hub may only read/write documents under its own hubs/{hubId} tree.
// The pairing Cloud Function mints custom tokens whose uid == hubId.
service cloud.firestore {
  match /databases/{database}/documents {
    match /hubs/{hubId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == hubId;
    }

    // Pairing codes are managed by the Cloud Function (Admin SDK) only.
    match /pairingCodes/{code} {
      allow read, write: if false;
    }
  }
}
