rules_version = '2';

// No Cloud Functions. Home Assistant signs in anonymously and claims a hub key
// by writing its uid into hubs/{key}. Everything under hubs/{key}/data is then
// readable/writable only by that uid.
//
// The hub key is a high-entropy shared secret chosen by the user; self-service
// creation is allowed so no admin tooling is needed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /hubs/{key} {
      allow get: if request.auth != null;

      // First claim: create the doc owning it yourself.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'valid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.valid == true;

      // Re-claim / no-op: only the 'uid' field may change, only to you, and
      // only when currently unclaimed or already yours.
      allow update: if request.auth != null
        && resource.data.valid == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && (!("uid" in resource.data) || resource.data.uid == request.auth.uid);

      allow delete: if false;

      match /data/{document=**} {
        allow read, write: if request.auth != null
          && get(/databases/$(database)/documents/hubs/$(key)).data.uid
             == request.auth.uid;
      }
    }
  }
}
